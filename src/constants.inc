EXPORT COLOR_L

; Playfield dimensions
DEF PLAYFIELD_WIDTH EQU 10
DEF PLAYFIELD_HEIGHT EQU 20
DEF PLAYFIELD_START_X EQU 1
DEF PLAYFIELD_START_Y EQU 1

; Tetromino types
DEF TETROMINO_I EQU 0
DEF TETROMINO_O EQU 1
DEF TETROMINO_T EQU 2
DEF TETROMINO_S EQU 3
DEF TETROMINO_Z EQU 4
DEF TETROMINO_J EQU 5
DEF TETROMINO_L EQU 6

; Number of tetromino types
DEF NUM_TETROMINOS EQU 7

; Rotation states
DEF ROTATION_0 EQU 0
DEF ROTATION_90 EQU 1
DEF ROTATION_180 EQU 2
DEF ROTATION_270 EQU 3

; Game states
DEF GAME_STATE_PLAYING EQU 0
DEF GAME_STATE_PAUSED EQU 1
DEF GAME_STATE_GAME_OVER EQU 2

; Input constants
DEF INPUT_LEFT EQU $20
DEF INPUT_RIGHT EQU $10
DEF INPUT_DOWN EQU $08
DEF INPUT_ROTATE EQU $04
DEF INPUT_DROP EQU $01

; Timing constants
DEF GRAVITY_DELAY EQU 30 ; frames before piece drops
DEF MOVE_DELAY EQU 8     ; frames before repeat input

; Colors (for CGB)
DEF COLOR_EMPTY EQU 0
DEF COLOR_I EQU 1
DEF COLOR_O EQU 2
DEF COLOR_T EQU 3
DEF COLOR_S EQU 4
DEF COLOR_Z EQU 5
DEF COLOR_J EQU 6
DEF COLOR_L EQU 7